# Project Sentinel — local configuration.
#
# Copy this file to `.env` (which is gitignored) and fill in your key:
#     cp .env.example .env
#
# Everything below is OPTIONAL. With no .env at all, Sentinel runs 100% offline
# on deterministic fakes — no network, no cost. The key is only used when you
# explicitly turn LLM mode on.

# Your Anthropic API key. Get one at https://console.anthropic.com/settings/keys
# Spent ONLY when SENTINEL_USE_LLM=1 and code makes a real call.
ANTHROPIC_API_KEY=

# Turn real Claude calls on (1) or off (0). Default 0 → fully offline on fakes.
SENTINEL_USE_LLM=0

# Which model the agents use. Default is the cheapest (Haiku 4.5: $1/$5 per 1M tokens).
# Bump to claude-sonnet-4-6 or claude-opus-4-8 for more capability at higher cost.
SENTINEL_LLM_MODEL=claude-haiku-4-5
